        "def plot_attention(model, tokenizer, text, title='Attention Heatmap'):\n",
        "    # ── Switch to eager attention to enable output_attentions ──\n",
        "    model.config.attn_implementation = \"eager\"\n",
        "    model = model.__class__.from_pretrained(\n",
        "        \"medicalai/ClinicalBERT\",\n",
        "        config=model.config,\n",
        "        attn_implementation=\"eager\"\n",
        "    ).to(device)\n",
        "    # Load fine-tuned weights back\n",
        "    model.load_state_dict(model_ft.state_dict())  # keeps your trained weights\n",
        "    model.eval()\n",
        "\n",
        "    inputs = tokenizer(text, return_tensors='pt', truncation=True,\n",
        "                       max_length=64, padding='max_length').to(device)\n",
