        "            color=plt.cm.Reds(np.array(att_f) / max(att_f)))\n",
        "    plt.xticks(range(len(tok_f)), tok_f, rotation=45, ha='right', fontsize=9)\n",
        "    plt.ylabel('Attention Score')\n",
        "    plt.title(title)\n",
